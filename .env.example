# Copy this file to .env and fill in the key. .env is ignored by git; this file holds placeholders only.

# Course-provided Vocareum key (used when model.provider is "vocareum" in config/agent.yaml).
VOCAREUM_API_KEY=voc-replace-me

# Only needed if you switch model.provider to "openai" in config/agent.yaml.
# OPENAI_API_KEY=sk-replace-me

# Optional: Langfuse tracing (`uv sync --extra observability`, then `salesops-agent ask ... --langfuse`).
# Self-hosted Langfuse runs at http://localhost:3000; Langfuse Cloud uses https://us.cloud.langfuse.com or https://cloud.langfuse.com.
# LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
# LANGFUSE_SECRET_KEY=sk-lf-replace-me
# LANGFUSE_HOST=http://localhost:3000
